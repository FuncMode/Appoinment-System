# Server
PORT=3000
NODE_ENV=development

# Supabase (server-side keys NEVER go to the frontend)
#   Settings → API → service-role / sb_secret key (backend-only; RLS bypass).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Auth / JWT
#   openssl rand -hex 32 for EACH — DIFFERENT values, never reuse one secret
#   for two purposes (ASVS V6.2).
JWT_ACCESS_SECRET=placeholder-access-secret-min-32-chars
JWT_REFRESH_SECRET=placeholder-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Field-level encryption (PHI) — docs/ENCRYPTION_DESIGN.md
#   AES-256-GCM key: openssl rand -hex 32 (64 hex chars; DIFFERENT from JWT keys).
#   Backend-only: never in DB, logs, or frontend. Rotation = new "v2:" prefix.
ENCRYPTION_KEY=placeholder-encryption-key-64-hex-chars

# Realtime (§J ng SECURITY_ALIGNMENT — i-uncomment SA PAG-IMPLEMENT ng realtime)
#   SUPABASE_SIGNING_PRIVATE_KEY=placeholder-exported-es256-private-key

# CORS (comma-separated allowed frontend origins; BAWAL ang wildcard *)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Brevo email service (v3 API key mula sa app.brevo.com → SMTP & API →
# "API keys & MCP" tab — HINDI ang SMTP key; sender ay dapat verified sa
# "Senders, domains, IPs"). NEVER commit the real key here — .env lang.
BREVO_API_KEY=xkeysib-placeholder-key
EMAIL_FROM_NAME=MedicaCare
EMAIL_FROM_ADDRESS=you@example.com
