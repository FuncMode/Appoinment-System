# Server
PORT=3000
NODE_ENV=development

# Supabase PostgreSQL (server-side keys NEVER go to the frontend)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Auth / JWT
#   Generate secrets with:  openssl rand -hex 32   (>= 32 bytes each; DIFFERENT
#   values for access and refresh — never reuse one secret for both).
JWT_ACCESS_SECRET=placeholder-access-secret
JWT_REFRESH_SECRET=placeholder-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Field-level encryption (PHI) — docs/ENCRYPTION_DESIGN.md
#   AES-256-GCM key: openssl rand -hex 32  (DIFFERENT secret from JWT keys —
#   never reuse one secret for two purposes). HINDI kailanman ipapadala sa
#   frontend o itatabi sa database; backend-only. Key rotation: bagong key =
#   bagong version prefix sa ciphertext ("v2:...") habang binabasa pa ang v1.
ENCRYPTION_KEY=placeholder-32-byte-hex-encryption-key

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Brevo email service
BREVO_API_KEY=placeholder-brevo-api-key
EMAIL_FROM_NAME=Healthcare Management Website
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
